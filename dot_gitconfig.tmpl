{{- $winUser := or (env "USERNAME") (env "USER") (ternary "manrig" .chezmoi.username .work) -}}
[user]
	name = {{ .name }}
	email = {{ .email }}
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIF5pT06+3YIjr2AsW0X6YMnboBtk8f9Ho/w7DJhYvt27
[gpg]
	format = ssh
[gpg "ssh"]
	{{- if eq .chezmoi.os "windows" }}
	program = C:/Users/{{ $winUser }}/AppData/Local/Microsoft/WindowsApps/op-ssh-sign.exe
	{{- else if eq .chezmoi.os "linux" }}
	{{-   if (.chezmoi.kernel.osrelease | lower | contains "microsoft") }}
	program = /mnt/c/Users/{{ $winUser }}/AppData/Local/Microsoft/WindowsApps/op-ssh-sign.exe
	{{-   else }}
	program = /opt/1Password/op-ssh-sign
	{{-   end }}
	{{- else if eq .chezmoi.os "darwin" }}
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
	{{- end }}
[commit]
	gpgsign = true
[init]
	defaultBranch = "main"
[core]
	excludesfile = ~/.config/git/ignore
{{- if eq .chezmoi.os "windows" }}
	sshCommand = C:/WINDOWS/System32/OpenSSH/ssh.exe
{{- end }}
[push]
	autoSetupRemote = true
	followTags = true
[pull]
	rebase = true
[fetch]
	prune = true
	pruneTags = true
[diff]
	algorithm = histogram
	colorMoved = plain
	mnemonicPrefix = true
[merge]
	conflictstyle = zdiff3
[rebase]
	autoSquash = true
	autoStash = true
[help]
	autocorrect = prompt
[url "git@github.com:"]
	insteadOf = https://github.com/
