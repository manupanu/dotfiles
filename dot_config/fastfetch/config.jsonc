{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "Apple",
    "padding": {
      "top": 1,
      "right": 2
    },
    "color": {
      "1": "#a6e3a1",
      "2": "#f9e2af",
      "3": "#fab387",
      "4": "#f38ba8",
      "5": "#cba6f7",
      "6": "#89b4fa"
    }
  },
  "display": {
    "separator": " 󰄾 ",
    "color": {
      "separator": "blue"
    }
  },
  "modules": [
    {
      "type": "title",
      "color": {
        "user": "blue",
        "at": "white",
        "host": "cyan"
      }
    },
    {
      "type": "separator",
      "string": "─"
    },
    {
      "type": "host",
      "key": "󰌢 Host",
      "keyColor": "blue"
    },
    {
      "type": "os",
      "key": "󰣇 OS",
      "keyColor": "cyan"
    },
    {
      "type": "kernel",
      "key": " Kernel",
      "keyColor": "blue"
    },
    {
      "type": "uptime",
      "key": "󰅐 Uptime",
      "keyColor": "cyan"
    },
    {
      "type": "packages",
      "key": "󰏖 Packages",
      "keyColor": "blue"
    },
    {
      "type": "shell",
      "key": " Shell",
      "keyColor": "cyan"
    },
    {
      "type": "terminal",
      "key": " Terminal",
      "keyColor": "blue"
    },
    {
      "type": "wm",
      "key": " WM",
      "keyColor": "cyan"
    },
    {
      "type": "display",
      "key": "󰍹 Display",
      "keyColor": "blue",
      "compactType": "original-with-refresh-rate"
    },
    {
      "type": "cpu",
      "key": "󰍛 CPU",
      "keyColor": "cyan",
      "showPeCoreCount": true
    },
    {
      "type": "gpu",
      "key": "󰢮 GPU",
      "keyColor": "blue"
    },
    {
      "type": "memory",
      "key": "󰘚 Memory",
      "keyColor": "cyan"
    },
    {
      "type": "swap",
      "key": "󰓡 Swap",
      "keyColor": "blue"
    },
    {
      "type": "disk",
      "key": "󰋊 Disk",
      "folders": "/",
      "format": "{size-used} / {size-total} ({size-percentage})",
      "keyColor": "cyan"
    },
    {
      "type": "battery",
      "key": "󱊣 Battery",
      "keyColor": "blue"
    },
    {
      "type": "poweradapter",
      "key": "󰚥 Power",
      "keyColor": "cyan"
    },
    {
      "type": "wifi",
      "key": "󰖩 Wi-Fi",
      "format": "{ssid} ({protocol})",
      "keyColor": "blue"
    },
    {
      "type": "localip",
      "key": "󰩟 Local IP",
      "showIpv4": true,
      "showIpv6": false,
      "showPrefixLen": false,
      "keyColor": "cyan"
    },
    {
      "type": "sound",
      "key": "󰓃 Sound",
      "keyColor": "blue"
    },
    {
      "type": "media",
      "key": "󰝚 Media",
      "format": "{?artist}{artist} - {?}{title}",
      "keyColor": "cyan"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
