# Ghostty — matching the Kitty configuration where supported

# Catppuccin Mocha, with Kitty's exact ANSI and selection colors.
theme = Catppuccin Mocha
palette = 7=#bac2de
palette = 9=#f38ba8
palette = 10=#a6e3a1
palette = 11=#f9e2af
palette = 12=#89b4fa
palette = 13=#f5c2e7
palette = 14=#94e2d5
palette = 15=#a6adc8
selection-foreground = #1e1e2e
selection-background = #f5e0dc

# Typography and background
font-family = Maple Mono Normal NL NF
font-size = 14
background-opacity = 0.85
background-blur = 20

# Cursor, selection, and safe pasting
cursor-style = bar
cursor-style-blink = true
clipboard-trim-trailing-spaces = true
clipboard-paste-protection = true
mouse-hide-while-typing = false

# Padding and inactive panes
window-padding-x = 12
window-padding-y = 12
window-padding-balance = true
unfocused-split-opacity = 0.8

# Splits inherit the current directory through shell integration.
keybind = ctrl+shift+enter=new_split:auto
keybind = ctrl+shift+d=new_split:right
keybind = ctrl+shift+s=new_split:down
keybind = ctrl+shift+left=goto_split:left
keybind = ctrl+shift+right=goto_split:right
keybind = ctrl+shift+up=goto_split:up
keybind = ctrl+shift+down=goto_split:down
keybind = ctrl+tab=next_tab
keybind = ctrl+shift+tab=previous_tab
keybind = ctrl+shift+z=toggle_split_zoom
keybind = ctrl+shift+y=toggle_split_zoom
keybind = ctrl+plus=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+0=reset_font_size
keybind = ctrl+shift+f5=reload_config

# macOS bindings
keybind = super+enter=new_split:auto
keybind = super+d=new_split:right
keybind = super+shift+d=new_split:down
keybind = super+alt+left=goto_split:left
keybind = super+alt+right=goto_split:right
keybind = super+alt+up=goto_split:up
keybind = super+alt+down=goto_split:down
keybind = super+shift+z=toggle_split_zoom
keybind = super+shift+y=toggle_split_zoom
keybind = super+plus=increase_font_size:1
keybind = super+minus=decrease_font_size:1
keybind = super+0=reset_font_size
keybind = super+ctrl+r=reload_config

# Native tabs integrated into the titlebar, and Kitty-style fullscreen.
# Non-native fullscreen temporarily separates macOS tabs into windows.
macos-titlebar-style = tabs
macos-option-as-alt = left
macos-non-native-fullscreen = true
quit-after-last-window-closed = true

shell-integration = detect
bell-features = no-system,no-audio,no-attention,no-title,no-border
