#!/usr/bin/env bash

set -Eeuo pipefail
# shellcheck source=/dev/null
source "$HOME/.local/lib/mangowm/common"

command_name=${1:-select}

mangowm_require nmcli
mangowm_require fuzzel

wifi_radio_status() {
  nmcli radio wifi 2>/dev/null || printf 'disabled\n'
}

wifi_device() {
  nmcli -t -f DEVICE,TYPE device status 2>/dev/null | awk -F: '$2=="wifi"{print $1; exit}'
}

wifi_signal_icon() {
  local signal=$1
  if (( signal >= 75 )); then
    printf '󰤨'
  elif (( signal >= 50 )); then
    printf '󰤥'
  elif (( signal >= 25 )); then
    printf '󰤢'
  else
    printf '󰤟'
  fi
}

launch_nmtui() {
  if command -v ghostty >/dev/null 2>&1; then
    "$HOME/.local/lib/mangowm/terminal" --app-id=floating-terminal \
      --title="Network Manager (nmtui)" -e nmtui &
  elif command -v nm-connection-editor >/dev/null 2>&1; then
    nm-connection-editor &
  else
    mangowm_notify critical 'Wi-Fi' 'nmtui or a compatible terminal not found'
  fi
}

wifi_saved_profiles() {
  local uuid type name
  while IFS=':' read -r uuid type name; do
    [[ "$type" == "802-11-wireless" && -n "$uuid" ]] || continue
    local ssid ifname ts
    ssid=$(nmcli -g 802-11-wireless.ssid connection show "$uuid" 2>/dev/null || true)
    ifname=$(nmcli -g connection.interface-name connection show "$uuid" 2>/dev/null || true)
    ts=$(nmcli -g connection.timestamp connection show "$uuid" 2>/dev/null || printf '0')
    printf '%s\t%s\t%s\t%s\t%s\n' "$uuid" "$name" "$ssid" "$ifname" "${ts:-0}"
  done < <(nmcli -t -f UUID,TYPE,NAME connection show 2>/dev/null || true)
}

find_best_saved_uuid() {
  local target_ssid=$1
  local cur_dev
  cur_dev=$(wifi_device)

  local best_uuid=""
  local best_score=-1
  local highest_ts=-1

  local uuid name ssid ifname ts
  while IFS=$'\t' read -r uuid name ssid ifname ts; do
    [[ -n "$uuid" ]] || continue
    if [[ "$ssid" == "$target_ssid" || ( -z "$ssid" && "$name" == "$target_ssid" ) ]]; then
      local score=0
      if [[ -z "$ifname" || "$ifname" == "--" || ( -n "$cur_dev" && "$ifname" == "$cur_dev" ) ]]; then
        score=10
      fi

      if (( score > best_score )) || { (( score == best_score )) && (( ts > highest_ts )); }; then
        best_score=$score
        highest_ts=$ts
        best_uuid=$uuid
      fi
    fi
  done < <(wifi_saved_profiles)

  printf '%s\n' "$best_uuid"
}

connect_saved_profile() {
  local target_uuid=$1
  local cur_dev
  cur_dev=$(wifi_device)

  # Auto-repair stale interface-name constraint if it mismatches active wifi interface
  local ifname
  ifname=$(nmcli -g connection.interface-name connection show "$target_uuid" 2>/dev/null || true)
  if [[ -n "$ifname" && "$ifname" != "--" && -n "$cur_dev" && "$ifname" != "$cur_dev" ]]; then
    nmcli connection modify "$target_uuid" connection.interface-name "" >/dev/null 2>&1 || true
  fi

  local output
  if output=$(nmcli connection up uuid "$target_uuid" 2>&1); then
    return 0
  fi

  # If failed due to interface mismatch, strip interface constraint and retry
  if [[ "$output" =~ (mismatching interface name|not compatible with device) ]]; then
    nmcli connection modify "$target_uuid" connection.interface-name "" >/dev/null 2>&1 || true
    if output=$(nmcli connection up uuid "$target_uuid" 2>&1); then
      return 0
    fi
  fi

  printf '%s\n' "$output"
  return 1
}

manage_saved_connections() {
  local theme_dir
  theme_dir=$(mangowm_theme_dir)

  local -A label_to_uuid=()
  local -A label_to_name=()
  local -a formatted=()

  local uuid name ssid ifname ts
  while IFS=$'\t' read -r uuid name ssid ifname ts; do
    [[ -n "$uuid" ]] || continue
    local item="󰤨   $name"
    if [[ -n "$ssid" && "$ssid" != "$name" ]]; then
      item="󰤨   $name  ($ssid)"
    fi
    formatted+=("$item")
    label_to_uuid["$item"]="$uuid"
    label_to_name["$item"]="$name"
  done < <(wifi_saved_profiles)

  if (( ${#formatted[@]} == 0 )); then
    mangowm_notify normal 'Wi-Fi' 'No saved Wi-Fi networks on this system'
    return 0
  fi

  local back_main="󰁍   Back to main menu"
  formatted+=("$back_main")

  local selected
  local lines=${#formatted[@]}
  (( lines > 11 )) && lines=11
  selected=$(printf '%s\n' "${formatted[@]}" | \
    fuzzel --dmenu --config="$theme_dir/fuzzel.ini" \
      --prompt="Saved Network ❯ " --lines="$lines" --width=45 || true)

  [[ -n "$selected" ]] || return 0

  if [[ "$selected" == "$back_main" ]]; then
    select_wifi_menu
    return 0
  fi

  local target_uuid="${label_to_uuid[$selected]-}"
  local target_name="${label_to_name[$selected]-}"
  [[ -n "$target_uuid" ]] || return 0

  local back_saved="󰁍   Back to saved networks"
  local actions=(
    "󰌘   Connect to this network"
    "󰆴   Forget / Remove network"
    "$back_saved"
  )

  local action
  action=$(printf '%s\n' "${actions[@]}" | \
    fuzzel --dmenu --config="$theme_dir/fuzzel.ini" \
      --prompt="$target_name ❯ " --lines=3 --width=35 || true)

  case "$action" in
    *"Connect to this"*)
      mangowm_notify low 'Wi-Fi' "Connecting to $target_name..."
      if connect_saved_profile "$target_uuid" >/dev/null 2>&1; then
        mangowm_notify normal 'Wi-Fi' "Connected successfully to $target_name"
      else
        mangowm_notify critical 'Wi-Fi' "Failed to connect to $target_name"
      fi
      ;;
    *"Forget"*)
      if nmcli connection delete uuid "$target_uuid" >/dev/null 2>&1; then
        mangowm_notify normal 'Wi-Fi' "Network removed: $target_name"
      else
        mangowm_notify critical 'Wi-Fi' "Failed to remove: $target_name"
      fi
      manage_saved_connections
      ;;
    *"Back"*)
      manage_saved_connections
      ;;
  esac
}

show_active_connection_menu() {
  local ssid=$1
  local theme_dir
  theme_dir=$(mangowm_theme_dir)

  local cur_dev
  cur_dev=$(wifi_device)
  local active_uuid=""
  if [[ -n "$cur_dev" ]]; then
    active_uuid=$(nmcli -g GENERAL.CON-UUID device show "$cur_dev" 2>/dev/null || true)
  fi
  [[ -n "$active_uuid" ]] || active_uuid=$(find_best_saved_uuid "$ssid")

  local back_main="󰁍   Back to main menu"
  local actions=(
    "󰤭   Disconnect from $ssid"
    "󰆴   Forget / Remove saved network"
    "󰛳   Connection information"
    "$back_main"
  )

  local selected
  selected=$(printf '%s\n' "${actions[@]}" | \
    fuzzel --dmenu --config="$theme_dir/fuzzel.ini" \
      --prompt="$ssid ❯ " --lines=4 --width=42 || true)

  case "$selected" in
    *"Disconnect"*)
      local disc_ok=0
      if [[ -n "$cur_dev" ]] && nmcli device disconnect "$cur_dev" >/dev/null 2>&1; then
        disc_ok=1
      elif [[ -n "$active_uuid" ]] && nmcli connection down uuid "$active_uuid" >/dev/null 2>&1; then
        disc_ok=1
      fi

      if (( disc_ok == 1 )); then
        mangowm_notify normal 'Wi-Fi' "Disconnected from $ssid"
      else
        mangowm_notify critical 'Wi-Fi' "Could not disconnect from $ssid"
      fi
      ;;
    *"Forget"*)
      if [[ -n "$active_uuid" ]] && nmcli connection delete uuid "$active_uuid" >/dev/null 2>&1; then
        mangowm_notify normal 'Wi-Fi' "Network removed: $ssid"
      elif nmcli connection delete id "$ssid" >/dev/null 2>&1; then
        mangowm_notify normal 'Wi-Fi' "Network removed: $ssid"
      else
        mangowm_notify critical 'Wi-Fi' "Failed to remove: $ssid"
      fi
      ;;
    *"information"*)
      local ip gw dns
      if [[ -n "$active_uuid" ]]; then
        ip=$(nmcli -g IP4.ADDRESS connection show "$active_uuid" 2>/dev/null | head -n 1 || true)
        gw=$(nmcli -g IP4.GATEWAY connection show "$active_uuid" 2>/dev/null || true)
        dns=$(nmcli -g IP4.DNS connection show "$active_uuid" 2>/dev/null || true)
      fi
      mangowm_notify normal "Details of $ssid" "IP: ${ip:-N/A}\nGateway: ${gw:-N/A}\nDNS: ${dns:-N/A}"
      ;;
    *"Back"*)
      select_wifi_menu
      ;;
  esac
}

connect_wifi_network() {
  local ssid=$1
  local security=$2
  local is_saved=$3
  local theme_dir
  theme_dir=$(mangowm_theme_dir)

  if [[ "$is_saved" == 1 ]]; then
    mangowm_notify low 'Wi-Fi' "Connecting to $ssid..."
    local best_uuid
    best_uuid=$(find_best_saved_uuid "$ssid")

    if [[ -n "$best_uuid" ]]; then
      if connect_saved_profile "$best_uuid" >/dev/null 2>&1; then
        mangowm_notify normal 'Wi-Fi' "Connected successfully to $ssid"
        return 0
      fi
    else
      if nmcli device wifi connect "$ssid" >/dev/null 2>&1; then
        mangowm_notify normal 'Wi-Fi' "Connected successfully to $ssid"
        return 0
      fi
    fi

    # Saved profile connection failed; offer password retry or nmtui
    mangowm_notify critical 'Wi-Fi' "Failed to connect to $ssid with the saved profile"
    local retry_options=(
      "󰌘   Enter new password"
      "󰒓   Open settings (nmtui)"
      "󰁍   Cancel"
    )
    local retry_choice
    retry_choice=$(printf '%s\n' "${retry_options[@]}" | \
      fuzzel --dmenu --config="$theme_dir/fuzzel.ini" \
        --prompt="Error on $ssid ❯ " --lines=3 --width=38 || true)

    case "$retry_choice" in
      *"new password"*)
        local password
        password=$(fuzzel --dmenu --password --config="$theme_dir/fuzzel.ini" \
          --prompt="Password ($ssid) ❯ " --lines=0 --width=38 || true)
        [[ -n "$password" ]] || return 0

        mangowm_notify low 'Wi-Fi' "Authenticating on $ssid..."
        if nmcli device wifi connect "$ssid" password "$password" >/dev/null 2>&1; then
          mangowm_notify normal 'Wi-Fi' "Connected successfully to $ssid"
        else
          mangowm_notify critical 'Wi-Fi' "Authentication error on $ssid"
        fi
        ;;
      *"nmtui"*)
        launch_nmtui
        ;;
    esac
    return 0
  fi

  if [[ -n "$security" && "$security" != "--" ]]; then
    local password
    password=$(fuzzel --dmenu --password --config="$theme_dir/fuzzel.ini" \
      --prompt="Password ($ssid) ❯ " --lines=0 --width=38 || true)

    [[ -n "$password" ]] || return 0

    mangowm_notify low 'Wi-Fi' "Authenticating on $ssid..."
    if nmcli device wifi connect "$ssid" password "$password" >/dev/null 2>&1; then
      mangowm_notify normal 'Wi-Fi' "Connected successfully to $ssid"
    else
      mangowm_notify critical 'Wi-Fi' "Authentication error on $ssid"
    fi
  else
    mangowm_notify low 'Wi-Fi' "Connecting to open network $ssid..."
    if nmcli device wifi connect "$ssid" >/dev/null 2>&1; then
      mangowm_notify normal 'Wi-Fi' "Connected successfully to $ssid"
    else
      mangowm_notify critical 'Wi-Fi' "Error connecting to $ssid"
    fi
  fi
}

select_wifi_menu() {
  local theme_dir
  theme_dir=$(mangowm_theme_dir)

  local radio
  radio=$(wifi_radio_status)

  if [[ "$radio" == "disabled" ]]; then
    local disabled_options=(
      "󰤨   Enable Wi-Fi"
      "󰒓   Advanced settings (nmtui)"
    )
    local choice
    choice=$(printf '%s\n' "${disabled_options[@]}" | \
      fuzzel --dmenu --config="$theme_dir/fuzzel.ini" \
        --prompt="Wi-Fi (Disabled) ❯ " --lines=2 --width=38 || true)

    case "$choice" in
      *"Enable Wi-Fi"*)
        nmcli radio wifi on
        mangowm_notify normal 'Wi-Fi' 'Wi-Fi enabled'
        ;;
      *"Advanced settings"*)
        launch_nmtui
        ;;
    esac
    return 0
  fi

  local -A saved_ssids=()
  local -A saved_names=()
  local uuid name ssid ifname ts
  while IFS=$'\t' read -r uuid name ssid ifname ts; do
    [[ -n "$uuid" ]] || continue
    [[ -n "$ssid" ]] && saved_ssids["$ssid"]=1
    [[ -n "$name" ]] && saved_names["$name"]=1
  done < <(wifi_saved_profiles)

  local active_ssid=""
  local active_signal="0"
  local -A best_signal=()
  local -A best_security=()
  local -a ssids_order=()

  while IFS=':' read -r in_use signal security ssid; do
    [[ -n "$ssid" && "$ssid" != "--" ]] || continue

    if [[ "$in_use" == "*" ]]; then
      active_ssid="$ssid"
      active_signal="$signal"
    fi

    if [[ -z "${best_signal[$ssid]-}" ]]; then
      ssids_order+=("$ssid")
      best_signal["$ssid"]=$signal
      best_security["$ssid"]=$security
    elif (( signal > best_signal[$ssid] )); then
      best_signal["$ssid"]=$signal
      best_security["$ssid"]=$security
    fi
  done < <(nmcli -g IN-USE,SIGNAL,SECURITY,SSID dev wifi list --rescan no 2>/dev/null || true)

  declare -A label_to_ssid=()
  declare -A label_to_action=()
  declare -a menu_items=()

  if [[ -n "$active_ssid" ]]; then
    local active_label="󰄬   $active_ssid  ($active_signal%)  [Connected]"
    menu_items+=("$active_label")
    label_to_ssid["$active_label"]="$active_ssid"
  fi

  local ssid
  for ssid in "${ssids_order[@]}"; do
    [[ "$ssid" != "$active_ssid" ]] || continue

    local sig=${best_signal[$ssid]}
    local sec=${best_security[$ssid]}
    local sig_icon
    sig_icon=$(wifi_signal_icon "$sig")
    local sec_icon="  "
    if [[ -n "$sec" && "$sec" != "--" ]]; then
      sec_icon="󰌾"
    fi

    local saved_marker=""
    if [[ -n "${saved_ssids[$ssid]-}" || -n "${saved_names[$ssid]-}" ]]; then
      saved_marker=" [Saved]"
    fi

    local label="$sig_icon   $ssid  ($sig%)  $sec_icon$saved_marker"
    menu_items+=("$label")
    label_to_ssid["$label"]="$ssid"
  done

  local act_off="󰤮   Disable Wi-Fi"
  local act_scan="󰑐   Scan networks"
  local act_saved="󰆴   Saved networks (Manage)"
  local act_adv="󰒓   Advanced settings (nmtui)"

  menu_items+=("$act_off" "$act_scan" "$act_saved" "$act_adv")
  label_to_action["$act_off"]="off"
  label_to_action["$act_scan"]="rescan"
  label_to_action["$act_saved"]="saved"
  label_to_action["$act_adv"]="nmtui"

  local total_lines=${#menu_items[@]}
  (( total_lines > 12 )) && total_lines=12

  local selection
  selection=$(printf '%s\n' "${menu_items[@]}" | \
    fuzzel --dmenu --config="$theme_dir/fuzzel.ini" \
      --prompt="Wi-Fi ❯ " --lines="$total_lines" --width=46 || true)

  [[ -n "$selection" ]] || return 0

  local action=${label_to_action[$selection]-}
  if [[ -n "$action" ]]; then
    case "$action" in
      off)
        nmcli radio wifi off
        mangowm_notify normal 'Wi-Fi' 'Wi-Fi disabled'
        ;;
      rescan)
        mangowm_notify low 'Wi-Fi' 'Scanning nearby networks...'
        nmcli dev wifi rescan 2>/dev/null || true
        sleep 1.5
        select_wifi_menu
        ;;
      saved)
        manage_saved_connections
        ;;
      nmtui)
        launch_nmtui
        ;;
    esac
    return 0
  fi

  local selected_ssid=${label_to_ssid[$selection]-}
  if [[ -n "$selected_ssid" ]]; then
    if [[ "$selected_ssid" == "$active_ssid" ]]; then
      show_active_connection_menu "$selected_ssid"
    else
      local sec=${best_security[$selected_ssid]-}
      local is_saved=0
      if [[ -n "${saved_ssids[$selected_ssid]-}" || -n "${saved_names[$selected_ssid]-}" ]]; then
        is_saved=1
      fi
      connect_wifi_network "$selected_ssid" "$sec" "$is_saved"
    fi
  fi
}

toggle_wifi() {
  local radio
  radio=$(wifi_radio_status)
  if [[ "$radio" == "enabled" ]]; then
    nmcli radio wifi off
    mangowm_notify normal 'Wi-Fi' 'Wi-Fi disabled'
  else
    nmcli radio wifi on
    mangowm_notify normal 'Wi-Fi' 'Wi-Fi enabled'
  fi
}

wifi_status() {
  local radio
  radio=$(wifi_radio_status)
  if [[ "$radio" != "enabled" ]]; then
    printf 'disabled\n'
    return 0
  fi

  local active
  active=$(nmcli -g IN-USE,SSID,SIGNAL dev wifi list 2>/dev/null | awk -F: '$1=="*"{print $2 " (" $3 "%)"}' | head -n 1)
  if [[ -n "$active" ]]; then
    printf '%s\n' "$active"
  else
    printf 'disconnected\n'
  fi
}

case "$command_name" in
  select|menu)
    select_wifi_menu
    ;;
  toggle)
    toggle_wifi
    ;;
  on)
    nmcli radio wifi on
    mangowm_notify normal 'Wi-Fi' 'Wi-Fi enabled'
    ;;
  off)
    nmcli radio wifi off
    mangowm_notify normal 'Wi-Fi' 'Wi-Fi disabled'
    ;;
  rescan)
    nmcli dev wifi rescan
    mangowm_notify low 'Wi-Fi' 'Scanning networks...'
    ;;
  status)
    wifi_status
    ;;
  saved)
    manage_saved_connections
    ;;
  *)
    printf 'Usage: %s select|toggle|on|off|rescan|status|saved\n' "${0##*/}" >&2
    exit 2
    ;;
esac
