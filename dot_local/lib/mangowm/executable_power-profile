#!/usr/bin/env bash

set -Eeuo pipefail
# shellcheck source=/dev/null
source "$HOME/.local/lib/mangowm/common"

command_name=${1:-next}

mangowm_require powerprofilesctl

get_current() {
  powerprofilesctl get 2>/dev/null || printf 'balanced\n'
}

set_profile() {
  local target=$1
  if powerprofilesctl set "$target" 2>/dev/null; then
    local label icon
    case "$target" in
      power-saver) label="Power saver"; icon="󰌪" ;;
      balanced)    label="Balanced"; icon="󰾅" ;;
      performance) label="High performance"; icon="󰓅" ;;
      *)           label="$target"; icon="" ;;
    esac
    mangowm_notify low "Power Profile" "$icon $label active"
    pkill -RTMIN+8 waybar 2>/dev/null || true
  fi
}

waybar_json() {
  local current
  current=$(get_current)
  local icon label class
  case "$current" in
    power-saver)
      icon="󰌪"
      label="Power saver"
      class="power-saver"
      ;;
    performance)
      icon="󰓅"
      label="High performance"
      class="performance"
      ;;
    balanced|*)
      icon="󰾅"
      label="Balanced"
      class="balanced"
      ;;
  esac
  printf '{"text":"%s","alt":"%s","tooltip":"Power Profile: %s (%s)\\n\\nClick to change mode","class":"%s"}\n' \
    "$icon" "$current" "$label" "$current" "$class"
}

case "$command_name" in
  next|up)
    current=$(get_current)
    case "$current" in
      power-saver) set_profile balanced ;;
      balanced)    set_profile performance ;;
      performance) set_profile power-saver ;;
      *)           set_profile balanced ;;
    esac
    ;;
  prev|down)
    current=$(get_current)
    case "$current" in
      performance) set_profile balanced ;;
      balanced)    set_profile power-saver ;;
      power-saver) set_profile performance ;;
      *)           set_profile power-saver ;;
    esac
    ;;
  select|menu)
    current=$(get_current)
    mangowm_require fuzzel
    theme_dir=$(mangowm_theme_dir)

    tag_saver=""
    tag_balanced=""
    tag_perf=""
    case "$current" in
      power-saver) tag_saver="  [Active]" ;;
      balanced)    tag_balanced="  [Active]" ;;
      performance) tag_perf="  [Active]" ;;
    esac

    options=(
      "󰌪  Power Saver (power-saver)${tag_saver}"
      "󰾅  Balanced (balanced)${tag_balanced}"
      "󰓅  High Performance (performance)${tag_perf}"
    )

    selected=$(printf '%s\n' "${options[@]}" | \
      fuzzel --dmenu --config="$theme_dir/fuzzel.ini" \
        --prompt="Power Profile ❯ " --lines=3 --width=42 || true)

    case "$selected" in
      *"power-saver"*) set_profile power-saver ;;
      *"balanced"*)    set_profile balanced ;;
      *"performance"*) set_profile performance ;;
    esac
    ;;
  waybar|status)
    waybar_json
    ;;
  set)
    set_profile "${2:-balanced}"
    ;;
  get)
    get_current
    ;;
  *)
    printf 'Usage: %s next|prev|up|down|select|waybar|set <profile>|get\n' "${0##*/}" >&2
    exit 2
    ;;
esac
